# ============================================================
# ResilioChain — Environment Template (safe to commit)
# Copy to .env and fill in real values.
# ============================================================

# --- MongoDB Atlas ---
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="resiliochain"

# --- AWS Bedrock (Claude) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"
BEDROCK_MODEL_SUPERVISOR=""
BEDROCK_MODEL_PLANNER=""

# --- LLM behavior ---
LLM_MODE="bedrock"          # bedrock | mock

# --- Voyage AI auto-embedding ---
EMBEDDING_MODE="autoembed"  # autoembed | explicit
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3"

# --- App ---
API_HOST="0.0.0.0"
API_PORT="8000"
CONFIDENCE_AUTO_THRESHOLD="85"
COMPLIANCE_MAX_RETRIES="3"

# --- LangSmith observability (optional) ---
LANGCHAIN_TRACING_V2="false"
# US default: https://api.smith.langchain.com | EU: https://eu.api.smith.langchain.com
# AWS-hosted (aws.smith.langchain.com): https://aws.api.smith.langchain.com
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="resiliochain"
